#!/usr/bin/env bash

CONFIG_FILE="$HOME/.config/hypr/hyprland.lua"

# Read the current value of the control variable (hyprland.lua:258)
CURRENT="$(grep -o '^local touchpadEnabled = [a-z]*' "$CONFIG_FILE" | head -n1 | awk '{print $NF}')"

if [ "$CURRENT" != "true" ] && [ "$CURRENT" != "false" ]; then
	echo "toggle_touchpad: couldn't find 'touchpadEnabled' in $CONFIG_FILE"
	exit 1
fi

# Icon names found at https://tabler.io/icons

if [ "$CURRENT" = "true" ]; then
	# Disable touchpad
	qs -c noctalia-shell ipc call toast send '{"title": "Disabling Touchpad", "body": "Touchpad is now disabled", "icon": "device-tablet-off"}'
	sed -i 's/^local touchpadEnabled = true/local touchpadEnabled = false/' "$CONFIG_FILE"
else
	# Enable touchpad
	qs -c noctalia-shell ipc call toast send '{"title": "Enabling Touchpad", "body": "Touchpad is now enabled", "icon": "device-tablet"}'
	sed -i 's/^local touchpadEnabled = false/local touchpadEnabled = true/' "$CONFIG_FILE"
fi

hyprctl reload