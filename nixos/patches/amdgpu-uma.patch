+/*
+ * The FA617NS.419 firmware exposes ATCS UMA GET/SET but its
+ * Integrated System Info table is revision 2.2, which does not
+ * provide the v2.3 UMA option metadata.
+ *
+ * The two indices below have been verified experimentally:
+ *   index 1 -> Productivity -> 512 MiB
+ *   index 2 -> Gaming       -> 2048 MiB
+ *
+ * Keep this fallback restricted to the tested machine and BIOS.
+ */
+static int amdgpu_uma_sysfs_init_fa617ns(struct amdgpu_device *adev)
+{
+	static const struct dmi_system_id fa617ns_systems[] = {
+		{
+			.ident = "ASUS TUF Gaming A16 FA617NS, BIOS 419",
+			.matches = {
+				DMI_MATCH(DMI_SYS_VENDOR, "ASUSTeK COMPUTER INC."),
+				DMI_MATCH(DMI_PRODUCT_NAME,
+					  "ASUS TUF Gaming A16 FA617NS_FA617NS"),
+				DMI_MATCH(DMI_BOARD_NAME, "FA617NS"),
+				DMI_MATCH(DMI_BIOS_VERSION, "FA617NS.419"),
+			},
+		},
+		{ }
+	};
+
+	static const struct amdgpu_uma_carveout_option options[] = {
+		{
+			.name = "Productivity",
+			.memory_carved_mb = 512,
+			.flags = AMDGPU_UMA_FLAG_CUSTOM,
+			.index = 1,
+			.uma_size_type = 0,
+		},
+		{
+			.name = "Gaming",
+			.memory_carved_mb = 2048,
+			.flags = AMDGPU_UMA_FLAG_CUSTOM,
+			.index = 2,
+			.uma_size_type = 0,
+		},
+	};
+
+	struct amdgpu_uma_carveout_info *uma_info = &adev->uma_info;
+	u32 current_size_mb;
+	int r;
+
+	if (!dmi_check_system(fa617ns_systems))
+		return -ENODEV;
+
+	r = amdgpu_acpi_get_uma_size(adev, &current_size_mb);
+	if (r)
+		return r;
+
+	switch (current_size_mb) {
+	case 512:
+		uma_info->uma_option_index = 1;
+		break;
+	case 2048:
+		uma_info->uma_option_index = 2;
+		break;
+	default:
+		drm_dbg(adev_to_drm(adev),
+			"FA617NS firmware reported unsupported UMA size: %u MiB\n",
+			current_size_mb);
+		return -EINVAL;
+	}
+
+	memcpy(uma_info->entries, options, sizeof(options));
+	uma_info->num_entries = ARRAY_SIZE(options);
+
+	drm_dbg(adev_to_drm(adev),
+		"Using FA617NS.419 ATCS UMA options; current allocation: %u MiB\n",
+		current_size_mb);
+
+	return 0;
+}
