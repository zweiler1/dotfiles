+/**
+ * amdgpu_acpi_get_uma_size - Get the current UMA allocation size via ACPI
+ * @adev: Pointer to the amdgpu_device structure
+ * @uma_size_mb: Receives the currently allocated UMA size in MiB
+ *
+ * Returns 0 on success or a negative error code on failure.
+ */
+int amdgpu_acpi_get_uma_size(struct amdgpu_device *adev, u32 *uma_size_mb)
+{
+	struct amdgpu_atcs *atcs = &amdgpu_acpi_priv.atcs;
+	union acpi_object *info;
+	struct atcs_get_uma_size_output output;
+	int r = 0;
+
+	if (!uma_size_mb)
+		return -EINVAL;
+
+	if (!atcs->functions.get_uma_size)
+		return -EOPNOTSUPP;
+
+	info = amdgpu_atcs_call(atcs, ATCS_FUNCTION_GET_UMA_SIZE, NULL);
+	if (!info) {
+		drm_dbg(adev_to_drm(adev),
+			"ATCS GET_UMA_SIZE call failed\n");
+		return -EIO;
+	}
+
+	if (info->type != ACPI_TYPE_BUFFER ||
+	    !info->buffer.pointer ||
+	    info->buffer.length < sizeof(output)) {
+		drm_dbg(adev_to_drm(adev),
+			"ATCS GET_UMA_SIZE returned an invalid buffer\n");
+		r = -EINVAL;
+		goto out;
+	}
+
+	memcpy(&output, info->buffer.pointer, sizeof(output));
+
+	if (output.size < sizeof(output) ||
+	    output.size > info->buffer.length) {
+		drm_dbg(adev_to_drm(adev),
+			"ATCS GET_UMA_SIZE returned an invalid structure size: %u\n",
+			(unsigned int)output.size);
+		r = -EINVAL;
+		goto out;
+	}
+
+	*uma_size_mb = output.uma_size_mb;
+
+out:
+	kfree(info);
+	return r;
+}
